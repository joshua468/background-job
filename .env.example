# How many jobs can this worker process concurrently (1-100)
JOB_CONCURRENCY_CAP=10

# Maximum retry attempts before a job goes dead (1-20)
JOB_MAX_ATTEMPTS=5

# How often worker claims jobs (seconds, > 0)
JOB_CLAIM_INTERVAL_SECONDS=2

# Exponential backoff: delay = base * (2^attempts) + jitter
JOB_BACKOFF_BASE_SECONDS=5

# Random jitter as percentage of calculated delay (0-100)
JOB_BACKOFF_JITTER_PERCENT=10

# If a job stays in "processing" longer than this, mark it stuck and recover (seconds)
JOB_STUCK_TIMEOUT_SECONDS=3600

# How often to check for stuck jobs (seconds)
JOB_CLEANUP_INTERVAL_SECONDS=300

# How often to log the in-flight job count (seconds). This is the line that
# proves the concurrency cap is holding in the logs.
JOB_HEARTBEAT_INTERVAL_SECONDS=10

# Database connection
DATABASE_URL=

# HTTP server port
PORT=3000

# Where the simulated providers persist their state (emails, pdfs)
DATA_DIR=./data/external